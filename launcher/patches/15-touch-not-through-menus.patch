diff --git a/components/lx_loader/lx_svc_disp.c b/components/lx_loader/lx_svc_disp.c
index 5717abf..2821d71 100644
--- a/components/lx_loader/lx_svc_disp.c
+++ b/components/lx_loader/lx_svc_disp.c
@@ -98,7 +98,8 @@ static int disp_touch_read(papp_surface_t *s, papp_touch_point_t *pts, int max)
     bsp_touch_point_t raw[BSP_TOUCH_MAX_POINTS];
     if (max > BSP_TOUCH_MAX_POINTS) max = BSP_TOUCH_MAX_POINTS;
     SVC_ENTER();
