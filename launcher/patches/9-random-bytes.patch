+/* getentropy(): the hardware random number generator (SYS v4), for libraries that ask the C library. */
+int getentropy(void *buf, size_t len)
+{
+    if (len > 256) { errno = EIO; return -1; }
+    return papp_random(buf, len) ? 0 : (errno = ENOSYS, -1);
+}
