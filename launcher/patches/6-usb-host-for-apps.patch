diff --git a/components/lx_loader/lx_svc_usbh.c b/components/lx_loader/lx_svc_usbh.c
new file mode 100644
index 0000000..ed8db99
--- /dev/null
+++ b/components/lx_loader/lx_svc_usbh.c
@@ -0,0 +1,519 @@
+/*
+ * USBH: raw USB host access for apps (papp_abi.h). A third client of the USB host library, beside
+ * the HID driver and the XInput client (lx_input), registered on an app's first call and kept for
+ * the launcher's life. It opens only what an app asks for, and an interface the HID or XInput
+ * driver holds cannot be claimed again, so the launcher's pads and keyboards are never disturbed.
+ *
+ * Threads: lx_usbh pumps the client's events (completions arrive there); app calls submit and
+ * block on a semaphore per endpoint, in 50 ms slices so an exit request, an unplug or close() ends
+ * the wait. Each endpoint takes one transfer at a time; different endpoints run side by side.
+ */
+#include "lx_services.h"
+
+#include <string.h>
+#include "esp_log.h"
+#include "esp_timer.h"
+#include "usb/usb_host.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/semphr.h"
+#include "freertos/task.h"
+
+static const char *TAG = "lx_usbh";
+
+#define SLICE_MS 50
+
+/* A pipe per endpoint: index 0 is EP0 (control), 1..15 the OUT endpoints, 17..31 the IN ones. Each has its own
+ * transfer buffer, completion and lock, so a read can wait on an IN endpoint while writes and control requests
+ * go on beside it (a serial adapter's reader, say). */
+#define PIPES 32
+typedef struct {
+    usb_transfer_t *t;                   /* grown as needed, freed on close */
+    size_t cap;
+    SemaphoreHandle_t done;              /* given by the completion callback */
+    SemaphoreHandle_t busy;              /* one transfer at a time on it */
+    volatile bool fin;                   /* the submitted transfer completed */
+    volatile bool inflight;              /* one is submitted */
+    uint8_t ep;
+} pipe_t;
+
+struct papp_usb_dev {
+    bool used;
+    volatile bool gone;
+    volatile bool closing;               /* close() is waiting: transfers give up */
+    uint8_t addr;
+    usb_device_handle_t h;
+    uint16_t claimed;                    /* bit per interface 0..15 */
+    uint16_t mps[16][2];                 /* [endpoint number][0 out, 1 in] of claimed interfaces */
+    SemaphoreHandle_t lock;              /* makes pipes, claims and releases */
+    pipe_t pipe[PIPES];
+};
+
+static int pipe_index(uint8_t ep) { return (ep & 0x0F) ? (ep & 0x0F) | (ep & 0x80 ? 16 : 0) : 0; }
+
+static usb_host_client_handle_t s_client;
+static SemaphoreHandle_t s_lock;         /* the device table */
+static struct papp_usb_dev s_devs[PAPP_USBH_MAX_DEVS];
+static volatile uint32_t s_gen;
+static bool s_failed;
+
+static void client_cb(const usb_host_client_event_msg_t *msg, void *arg)
+{
+    (void)arg;
+    if (msg->event == USB_HOST_CLIENT_EVENT_NEW_DEV) {
+        s_gen++;
+    } else if (msg->event == USB_HOST_CLIENT_EVENT_DEV_GONE) {
+        s_gen++;
+        for (int i = 0; i < PAPP_USBH_MAX_DEVS; i++)
+            if (s_devs[i].used && s_devs[i].h == msg->dev_gone.dev_hdl) {
+                s_devs[i].gone = true;
+                for (int p = 0; p < PIPES; p++)
+                    if (s_devs[i].pipe[p].done) xSemaphoreGive(s_devs[i].pipe[p].done);   /* waiters look again */
+            }
+    }
+}
+
+static void client_task(void *arg)
+{
+    (void)arg;
+    for (;;) usb_host_client_handle_events(s_client, pdMS_TO_TICKS(SLICE_MS));
+}
+
+/* Registers the client on first use: false when the board has no USB host running. */
+static bool ready(void)
+{
+    if (s_client) return true;
+    if (s_failed) return false;
+    if (!s_lock) s_lock = xSemaphoreCreateMutex();
+    const usb_host_client_config_t cfg = {
+        .is_synchronous = false,
+        .max_num_event_msg = 8,
+        .async = { .client_event_callback = client_cb, .callback_arg = NULL },
+    };
+    esp_err_t e = usb_host_client_register(&cfg, &s_client);
+    if (e != ESP_OK) {
+        ESP_LOGW(TAG, "no USB host for apps (%s)", esp_err_to_name(e));
+        s_client = NULL;
+        s_failed = true;
+        return false;
+    }
+    if (xTaskCreatePinnedToCore(client_task, "lx_usbh", 4096, NULL, 5, NULL, 0) != pdPASS) {
+        usb_host_client_deregister(s_client);
+        s_client = NULL;
+        s_failed = true;
+        return false;
+    }
+    return true;
+}
+
+static bool valid(papp_usb_dev_t *d)
+{
+    return d && d >= s_devs && d < s_devs + PAPP_USBH_MAX_DEVS && d->used;
+}
+
+static void ascii(char *out, size_t n, const usb_str_desc_t *sd)
+{
+    size_t k = 0;
+    for (int i = 0; sd && i < (sd->bLength - 2) / 2 && k + 1 < n; i++) {
+        uint16_t c = sd->wData[i];
+        out[k++] = c >= 0x20 && c < 0x7F ? (char)c : '?';
+    }
+    out[k] = 0;
+}
+
+static void describe(usb_device_handle_t h, uint8_t addr, papp_usb_info_t *o)
+{
+    memset(o, 0, sizeof(*o));
+    o->addr = addr;
+    const usb_device_desc_t *dd = NULL;
+    if (usb_host_get_device_descriptor(h, &dd) == ESP_OK && dd) {
+        o->vid = dd->idVendor;
+        o->pid = dd->idProduct;
+        o->bcd_device = dd->bcdDevice;
+        o->dev_class = dd->bDeviceClass;
+        o->dev_subclass = dd->bDeviceSubClass;
+        o->dev_protocol = dd->bDeviceProtocol;
+    }
+    usb_device_info_t info = { 0 };
+    if (usb_host_device_info(h, &info) == ESP_OK) {
+        o->speed = info.speed == USB_SPEED_HIGH ? 2 : info.speed == USB_SPEED_FULL ? 1 : 0;
+        ascii(o->manufacturer, sizeof(o->manufacturer), info.str_desc_manufacturer);
+        ascii(o->product, sizeof(o->product), info.str_desc_product);
+        ascii(o->serial, sizeof(o->serial), info.str_desc_serial_num);
+    }
+    const usb_config_desc_t *cd = NULL;
+    if (usb_host_get_active_config_descriptor(h, &cd) == ESP_OK && cd) o->num_interfaces = cd->bNumInterfaces;
+}
+
+static int usbh_list(papp_usb_info_t *out, int max)
+{
+    SVC_ENTER();
+    int r = PAPP_E_UNSUPPORTED;
+    if (ready()) {
+        uint8_t addrs[16];
+        int n = 0;
+        if (usb_host_device_addr_list_fill(sizeof(addrs), addrs, &n) != ESP_OK) n = 0;
+        int k = 0;
+        xSemaphoreTake(s_lock, portMAX_DELAY);
+        for (int i = 0; i < n && k < max; i++) {
+            usb_device_handle_t h = NULL;
+            bool ours = false;
+            for (int j = 0; j < PAPP_USBH_MAX_DEVS; j++)
+                if (s_devs[j].used && !s_devs[j].gone && s_devs[j].addr == addrs[i]) { h = s_devs[j].h; ours = true; }
+            if (!h && usb_host_device_open(s_client, addrs[i], &h) != ESP_OK) continue;
+            describe(h, addrs[i], &out[k++]);
+            if (!ours) usb_host_device_close(s_client, h);
+        }
+        xSemaphoreGive(s_lock);
+        r = k;
+    }
+    SVC_LEAVE();
+    return r;
+}
+
+static uint32_t usbh_generation(void)
+{
+    ready();
+    return s_gen;
+}
+
+/* Gets a submitted transfer back without its completion: flushed (EP0's cannot be: waited out). */
+static void abandon(papp_usb_dev_t *d, pipe_t *p)
+{
+    if (p->ep & 0x0F) {
+        usb_host_endpoint_halt(d->h, p->ep);
+        usb_host_endpoint_flush(d->h, p->ep);
+    }
+    for (int i = 0; i < 40 && !p->fin; i++) xSemaphoreTake(p->done, pdMS_TO_TICKS(SLICE_MS));
+    if (p->ep & 0x0F) usb_host_endpoint_clear(d->h, p->ep);
+    p->inflight = false;
+}
+
+static void free_dev(papp_usb_dev_t *d)
+{
+    for (int i = 0; i < PIPES; i++) {
+        pipe_t *p = &d->pipe[i];
+        if (p->inflight && d->h) abandon(d, p);       /* its thread was killed mid-transfer */
+        if (p->t) usb_host_transfer_free(p->t);
+        if (p->done) vSemaphoreDelete(p->done);
+        if (p->busy) vSemaphoreDelete(p->busy);
+    }
+    if (d->h) {
+        for (int i = 0; i < 16; i++)
+            if (d->claimed & (1u << i)) usb_host_interface_release(s_client, d->h, (uint8_t)i);
+        usb_host_device_close(s_client, d->h);
+    }
+    if (d->lock) vSemaphoreDelete(d->lock);
+    memset(d, 0, sizeof(*d));
+}
+
+static papp_usb_dev_t *usbh_open(uint8_t addr, int *err)
+{
+    SVC_ENTER();
+    int e = PAPP_E_UNSUPPORTED;
+    papp_usb_dev_t *r = NULL;
+    if (ready()) {
+        xSemaphoreTake(s_lock, portMAX_DELAY);
+        papp_usb_dev_t *d = NULL;
+        for (int i = 0; i < PAPP_USBH_MAX_DEVS; i++)
+            if (s_devs[i].used && s_devs[i].addr == addr && !s_devs[i].gone) { e = PAPP_E_ARG; goto out; }  /* open already */
+        for (int i = 0; i < PAPP_USBH_MAX_DEVS && !d; i++)
+            if (!s_devs[i].used) d = &s_devs[i];
+        if (!d) { e = PAPP_E_LIMIT; goto out; }
+        d->lock = xSemaphoreCreateMutex();
+        if (!d->lock) { free_dev(d); e = PAPP_E_NOMEM; goto out; }
+        if (usb_host_device_open(s_client, addr, &d->h) != ESP_OK) { d->h = NULL; free_dev(d); e = PAPP_E_ARG; goto out; }
+        d->used = true;
+        d->addr = addr;
+        r = d;
+        e = PAPP_E_OK;
+out:
+        xSemaphoreGive(s_lock);
+    }
+    if (err) *err = e;
+    SVC_LEAVE();
+    return r;
+}
+
+/* The pipe for ep, made on first use. NULL: no memory. */
+static pipe_t *pipe_for(papp_usb_dev_t *d, uint8_t ep)
+{
+    pipe_t *p = &d->pipe[pipe_index(ep)];
+    if (p->busy) return p;
+    xSemaphoreTake(d->lock, portMAX_DELAY);
+    if (!p->busy) {
+        p->done = xSemaphoreCreateBinary();
+        SemaphoreHandle_t b = xSemaphoreCreateMutex();
+        p->ep = ep & 0x0F ? ep : 0;
+        if (p->done && b) p->busy = b;
+        else if (b) vSemaphoreDelete(b);
+    }
+    xSemaphoreGive(d->lock);
+    return p->busy ? p : NULL;
+}
+
+static void usbh_close(papp_usb_dev_t *d)
+{
+    SVC_ENTER();
+    if (s_lock && valid(d)) {
+        d->closing = true;                            /* a waiting transfer gives up within SLICE_MS */
+        for (int i = 0; i < PIPES; i++)
+            if (d->pipe[i].busy) xSemaphoreTake(d->pipe[i].busy, portMAX_DELAY);
+        xSemaphoreTake(s_lock, portMAX_DELAY);
+        free_dev(d);
+        xSemaphoreGive(s_lock);
+    }
+    SVC_LEAVE();
+}
+
+static int usbh_info(papp_usb_dev_t *d, papp_usb_info_t *out)
+{
+    if (!valid(d) || !out) return PAPP_E_ARG;
+    if (d->gone) return PAPP_E_RESET;
+    SVC_ENTER();
+    describe(d->h, d->addr, out);
+    SVC_LEAVE();
+    return PAPP_E_OK;
+}
+
+static int usbh_config_descriptor(papp_usb_dev_t *d, void *buf, size_t len)
+{
+    if (!valid(d)) return PAPP_E_ARG;
+    if (d->gone) return PAPP_E_RESET;
+    const usb_config_desc_t *cd = NULL;
+    if (usb_host_get_active_config_descriptor(d->h, &cd) != ESP_OK || !cd) return PAPP_E_IO;
+    if (buf && len) memcpy(buf, cd, len < cd->wTotalLength ? len : cd->wTotalLength);
+    return cd->wTotalLength;
+}
+
+/* The endpoints of interface `intf` (alternate `alt`) go in the device's packet-size table. */
+static void note_endpoints(papp_usb_dev_t *d, uint8_t intf, uint8_t alt)
+{
+    const usb_config_desc_t *cd = NULL;
+    if (usb_host_get_active_config_descriptor(d->h, &cd) != ESP_OK || !cd) return;
+    int off = 0;
+    const usb_intf_desc_t *id = usb_parse_interface_descriptor(cd, intf, alt, &off);
+    if (!id) return;
+    for (int e = 0; e < id->bNumEndpoints; e++) {
+        int eoff = off;
+        const usb_ep_desc_t *ep = usb_parse_endpoint_descriptor_by_index(id, e, cd->wTotalLength, &eoff);
+        if (ep) d->mps[ep->bEndpointAddress & 0x0F][ep->bEndpointAddress & 0x80 ? 1 : 0] = ep->wMaxPacketSize & 0x7FF;
+    }
+}
+
+static int usbh_claim(papp_usb_dev_t *d, uint8_t intf, uint8_t alt)
+{
+    if (!valid(d) || intf > 15) return PAPP_E_ARG;
+    if (d->gone) return PAPP_E_RESET;
+    SVC_ENTER();
+    xSemaphoreTake(d->lock, portMAX_DELAY);
+    int r = PAPP_E_OK;
+    if (d->claimed & (1u << intf)) usb_host_interface_release(s_client, d->h, intf);    /* a new alternate */
+    d->claimed &= ~(1u << intf);
+    esp_err_t e = usb_host_interface_claim(s_client, d->h, intf, alt);
+    if (e == ESP_OK) {
+        d->claimed |= 1u << intf;
+        note_endpoints(d, intf, alt);
+    } else {
+        ESP_LOGW(TAG, "claiming interface %u of address %u failed: %s", intf, d->addr, esp_err_to_name(e));
+        r = e == ESP_ERR_NOT_FOUND ? PAPP_E_ARG : PAPP_E_IO;
+    }
+    xSemaphoreGive(d->lock);
+    SVC_LEAVE();
+    return r;
+}
+
+static int usbh_release(papp_usb_dev_t *d, uint8_t intf)
+{
+    if (!valid(d) || intf > 15 || !(d->claimed & (1u << intf))) return PAPP_E_ARG;
+    SVC_ENTER();
+    xSemaphoreTake(d->lock, portMAX_DELAY);
+    esp_err_t e = usb_host_interface_release(s_client, d->h, intf);   /* refused while one of its endpoints is busy */
+    if (e == ESP_OK || d->gone) d->claimed &= ~(1u << intf);
+    xSemaphoreGive(d->lock);
+    SVC_LEAVE();
+    return e == ESP_OK || d->gone ? PAPP_E_OK : PAPP_E_IO;
+}
+
+static void on_done(usb_transfer_t *t)
+{
+    pipe_t *p = (pipe_t *)t->context;
+    p->fin = true;
+    xSemaphoreGive(p->done);
+}
+
+/* The pipe's transfer with at least n bytes of buffer (grown as needed). */
+static usb_transfer_t *buffer(pipe_t *p, size_t n)
+{
+    if (n <= p->cap && p->t) return p->t;
+    if (p->t) usb_host_transfer_free(p->t);
+    p->t = NULL;
+    p->cap = 0;
+    size_t want = n < 64 ? 64 : n;
+    if (usb_host_transfer_alloc(want, 0, &p->t) != ESP_OK) { p->t = NULL; return NULL; }
+    p->cap = want;
+    return p->t;
+}
+
+static esp_err_t submit(papp_usb_dev_t *d, pipe_t *p)
+{
+    xSemaphoreTake(p->done, 0);                       /* a stale give */
+    p->fin = false;
+    p->inflight = true;
+    p->t->callback = on_done;
+    p->t->context = p;
+    p->t->device_handle = d->h;
+    p->t->timeout_ms = 0;
+    esp_err_t e = p->ep ? usb_host_transfer_submit(p->t) : usb_host_transfer_submit_control(s_client, p->t);
+    if (e != ESP_OK) p->inflight = false;
+    return e;
+}
+
+/* Submitted: waits for the completion, in slices. -> PAPP_E_* or the bytes moved. */
+static int wait(papp_usb_dev_t *d, pipe_t *p, uint32_t timeout_ms)
+{
+    int64_t end = timeout_ms ? esp_timer_get_time() + (int64_t)timeout_ms * 1000 : INT64_MAX;
+    for (;;) {
+        xSemaphoreTake(p->done, pdMS_TO_TICKS(SLICE_MS));
+        if (p->fin) {                                 /* (an unplug gives too, without finishing it) */
+            p->inflight = false;
+            switch (p->t->status) {
+            case USB_TRANSFER_STATUS_COMPLETED: return (int)p->t->actual_num_bytes;
+            case USB_TRANSFER_STATUS_NO_DEVICE: return PAPP_E_RESET;
+            case USB_TRANSFER_STATUS_TIMED_OUT: return PAPP_E_TIMEOUT;
+            default:                            return d->closing ? PAPP_E_RESET : PAPP_E_IO;  /* stall, error, cancelled */
+            }
+        }
+        bool exiting = lx_svc_exit_flag;
+        if (exiting || d->gone || d->closing || esp_timer_get_time() >= end) {
+            abandon(d, p);
+            return exiting ? PAPP_E_EXIT : (d->gone || d->closing) ? PAPP_E_RESET : PAPP_E_TIMEOUT;
+        }
+    }
+}
+
+static int usbh_control(papp_usb_dev_t *d, uint8_t type, uint8_t req, uint16_t value, uint16_t index,
+                        void *data, uint16_t len, uint32_t timeout_ms)
+{
+    if (!valid(d) || (len && !data)) return PAPP_E_ARG;
+    if (d->gone || d->closing) return PAPP_E_RESET;
+    pipe_t *p = pipe_for(d, 0);
+    if (!p) return PAPP_E_NOMEM;
+    SVC_ENTER();
+    xSemaphoreTake(p->busy, portMAX_DELAY);
+    int r;
+    usb_transfer_t *t = buffer(p, sizeof(usb_setup_packet_t) + len);
+    if (!t) {
+        r = PAPP_E_NOMEM;
+    } else {
+        usb_setup_packet_t *sp = (usb_setup_packet_t *)t->data_buffer;
+        sp->bmRequestType = type;
+        sp->bRequest = req;
+        sp->wValue = value;
+        sp->wIndex = index;
+        sp->wLength = len;
+        if (!(type & 0x80) && len) memcpy(t->data_buffer + sizeof(usb_setup_packet_t), data, len);
+        t->num_bytes = sizeof(usb_setup_packet_t) + len;
+        t->bEndpointAddress = 0;
+        if (submit(d, p) != ESP_OK) {
+            r = PAPP_E_IO;
+        } else {
+            r = wait(d, p, timeout_ms);
+            if (r >= 0) {
+                r -= sizeof(usb_setup_packet_t);
+                if (r < 0) r = 0;
+                if ((type & 0x80) && r) memcpy(data, t->data_buffer + sizeof(usb_setup_packet_t), (size_t)r);
+            }
+        }
+    }
+    xSemaphoreGive(p->busy);
+    SVC_LEAVE();
+    return r;
+}
+
+static int usbh_transfer(papp_usb_dev_t *d, uint8_t ep, void *data, size_t len, uint32_t timeout_ms)
+{
+    if (!valid(d) || !(ep & 0x0F) || (len && !data)) return PAPP_E_ARG;
+    if (d->gone || d->closing) return PAPP_E_RESET;
+    const bool in = ep & 0x80;
+    const uint16_t mps = d->mps[ep & 0x0F][in ? 1 : 0];
+    if (!mps) return PAPP_E_ARG;                       /* not an endpoint of a claimed interface */
+    pipe_t *p = pipe_for(d, ep);
+    if (!p) return PAPP_E_NOMEM;
+    SVC_ENTER();
+    xSemaphoreTake(p->busy, portMAX_DELAY);
+    int r;
+    const size_t n = in ? usb_round_up_to_mps(len ? len : 1, mps) : len;   /* INs in whole packets */
+    usb_transfer_t *t = buffer(p, n);
+    if (!t) {
+        r = PAPP_E_NOMEM;
+    } else {
+        if (!in && len) memcpy(t->data_buffer, data, len);
+        t->num_bytes = n;
+        t->bEndpointAddress = ep;
+        esp_err_t e = submit(d, p);
+        if (e != ESP_OK) {
+            r = e == ESP_ERR_INVALID_STATE ? PAPP_E_IO : PAPP_E_ARG;   /* a halted endpoint: clear_halt it */
+        } else {
+            r = wait(d, p, timeout_ms);
+            if (r > 0 && in) {
+                if ((size_t)r > len) r = (int)len;
+                memcpy(data, t->data_buffer, (size_t)r);
+            }
+        }
+    }
+    xSemaphoreGive(p->busy);
+    SVC_LEAVE();
+    return r;
+}
+
+static int usbh_clear_halt(papp_usb_dev_t *d, uint8_t ep)
+{
+    if (!valid(d) || !(ep & 0x0F)) return PAPP_E_ARG;
+    if (d->gone) return PAPP_E_RESET;
+    pipe_t *p = pipe_for(d, ep);
+    if (!p) return PAPP_E_NOMEM;
+    SVC_ENTER();
+    xSemaphoreTake(p->busy, portMAX_DELAY);           /* not under a transfer on it */
+    usb_host_endpoint_halt(d->h, ep);                  /* may be halted already: fine */
+    usb_host_endpoint_flush(d->h, ep);
+    esp_err_t e = usb_host_endpoint_clear(d->h, ep);
+    xSemaphoreGive(p->busy);
+    SVC_LEAVE();
+    return e == ESP_OK ? PAPP_E_OK : PAPP_E_IO;
+}
+
+static bool usbh_gone(papp_usb_dev_t *d)
+{
+    return !valid(d) || d->gone;
+}
+
+const papp_if_usbh_t lx_if_usbh = {
+    .hdr = { PAPP_IF_USBH, PAPP_IF_USBH_VER, sizeof(papp_if_usbh_t) },
+    .list = usbh_list,
+    .generation = usbh_generation,
+    .open = usbh_open,
+    .close = usbh_close,
+    .info = usbh_info,
+    .config_descriptor = usbh_config_descriptor,
+    .claim = usbh_claim,
+    .release = usbh_release,
+    .control = usbh_control,
+    .transfer = usbh_transfer,
+    .clear_halt = usbh_clear_halt,
+    .gone = usbh_gone,
+};
+
+int lx_svc_usbh_end_run(void)
+{
+    int n = 0;
+    if (!s_lock) return 0;
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    for (int i = 0; i < PAPP_USBH_MAX_DEVS; i++)
+        if (s_devs[i].used) {
+            free_dev(&s_devs[i]);                      /* app threads are gone; free_dev abandons what they left */
+            n++;
+        }
+    xSemaphoreGive(s_lock);
+    if (n) ESP_LOGI(TAG, "closed %d USB device%s the app left open", n, n == 1 ? "" : "s");
+    return n;
+}
